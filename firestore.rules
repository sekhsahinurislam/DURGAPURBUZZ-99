rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // DURGAPUR BUZZ Super Admin
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "QdERp0w3SAaS18UWc7qkjIXZmii2";
    }

    // Public can read published content. Admin can read drafts/hidden content too.
    function canReadPublishedOrAdmin() {
      return isAdmin()
        || (resource.data.status is string
            && resource.data.status == "published");
    }

    // Content collections managed from the Admin Panel.
    // Public read is limited to published documents; all writes are Admin-only.
    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
          "tools",
          "notices",
          "events",
          "socialPosts",
          "featuredItems",
          "pridePeople",
          "directoryCategories",
          "directoryItems",
          "directDirectoryItems",
          "listingPageControls"
        ] && canReadPublishedOrAdmin();

      allow write: if collectionName in [
          "tools",
          "notices",
          "events",
          "socialPosts",
          "featuredItems",
          "pridePeople",
          "directoryCategories",
          "directoryItems",
          "directDirectoryItems",
          "listingPageControls"
        ] && isAdmin();
    }

    // Website settings and public Directory submission-form configuration.
    // Public read is required by the website; only the Super Admin can change them.
    match /site/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /directorySuggestionForm/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy / general suggestions: admin may review and delete.
    // No public client-side Firestore submission is enabled in the current HTML.
    match /suggestions/{documentId} {
      allow read, write: if isAdmin();
    }

    // Public visitor counter. Only allow creation at 1 and +1 increments.
    // Other fields cannot be modified by public clients.
    match /site/visitorCounter {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          "count", "updatedAt"
        ])
        && request.resource.data.count == 1;

      allow update: if request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["count", "updatedAt"])
        && request.resource.data.count == resource.data.count + 1;

      allow delete: if isAdmin();
    }
  }
}

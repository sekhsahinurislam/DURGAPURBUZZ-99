rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "QdERp0w3SAaS18UWc7qkjIXZmii2";
    }
    // Storage is reserved for admin-uploaded site assets and downloadable forms.
    match /site-assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /forms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
